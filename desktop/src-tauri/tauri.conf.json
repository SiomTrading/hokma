{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hokma",
  "version": "0.0.0",
  "identifier": "com.siomtrading.hokma",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "SiomTrading USA LLC",
    "category": "Finance",
    "shortDescription": "Hokma",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
