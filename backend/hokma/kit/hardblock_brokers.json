{
  "version": 1,
  "note": "Hosts and URL shapes that place real-money orders. Data hosts, paper and sandbox hosts are not listed. A command that mentions one of these is refused by the always-on protections (rule real_money). `read_exceptions` is NOT read by that hook: an agent never gets one. It is the list of the only requests Hokma's own backend may make to a listed host (see `hardblock.read_exception_allows`). Schwab (SPEC-015): 19 reads and the OAuth token call only; sending, changing, cancelling or previewing an order is NOT in read_exceptions.",
  "hosts": [
    "api.alpaca.markets",
    "api-fxtrade.oanda.com",
    "stream-fxtrade.oanda.com",
    "live.tradovateapi.com",
    "api.tradier.com",
    "api.tradestation.com",
    "api.schwabapi.com",
    "api.tastyworks.com",
    "api.etrade.com",
    "api.robinhood.com",
    "api.kraken.com",
    "api.gemini.com",
    "api.bybit.com",
    "api.kucoin.com",
    "api.bitfinex.com",
    "api.ibkr.com",
    "ndax.io",
    "trading-api.kalshi.com"
  ],
  "order_exceptions_note": "The only order requests Hokma's broker service may make to Schwab (SPEC-015 18.7), consumer hokma_broker. Kept apart from read_exceptions: a rule of one list never authorizes a request of the other, and the hook reads neither (see hardblock.order_exception_allows).",
  "hokma_order_tools_note": "The exact MCP tool names of Hokma's own server that the real_money rule lets through its order-name pattern (SPEC-015 18.7). The host and secret checks still apply to them. The server name hokma is reserved (kit/mcp_config.py).",
  "hokma_order_tools": [
    "mcp__hokma__order_place",
    "mcp__hokma__order_replace",
    "mcp__hokma__order_cancel",
    "mcp__hokma__order_preview"
  ],
  "order_exceptions": [
    {
      "host": "api.schwabapi.com",
      "method": "POST",
      "path": "/trader/v1/accounts/{accountNumber}/orders",
      "match": "path_template",
      "consumer": "hokma_broker",
      "reason": "Place an order (SPEC-015 18.7)",
      "params": {
        "accountNumber": "(?!accountNumbers$)[A-Za-z0-9]{8,128}"
      }
    },
    {
      "host": "api.schwabapi.com",
      "method": "PUT",
      "path": "/trader/v1/accounts/{accountNumber}/orders/{orderId}",
      "match": "path_template",
      "consumer": "hokma_broker",
      "reason": "Replace an order (SPEC-015 18.7)",
      "params": {
        "accountNumber": "(?!accountNumbers$)[A-Za-z0-9]{8,128}",
        "orderId": "[0-9]{1,19}"
      }
    },
    {
      "host": "api.schwabapi.com",
      "method": "DELETE",
      "path": "/trader/v1/accounts/{accountNumber}/orders/{orderId}",
      "match": "path_template",
      "consumer": "hokma_broker",
      "reason": "Cancel an order (SPEC-015 18.7)",
      "params": {
        "accountNumber": "(?!accountNumbers$)[A-Za-z0-9]{8,128}",
        "orderId": "[0-9]{1,19}"
      }
    },
    {
      "host": "api.schwabapi.com",
      "method": "POST",
      "path": "/trader/v1/accounts/{accountNumber}/previewOrder",
      "match": "path_template",
      "consumer": "hokma_broker",
      "reason": "Preview an order (SPEC-015 18.7)",
      "params": {
        "accountNumber": "(?!accountNumbers$)[A-Za-z0-9]{8,128}"
      }
    }
  ],
  "read_exceptions": [
    {
      "host": "api.alpaca.markets",
      "method": "GET",
