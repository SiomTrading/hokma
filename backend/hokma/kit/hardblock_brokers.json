  "url_patterns": [
    "(?:api\\.exchange\\.coinbase\\.com|api\\.coinbase\\.com|api\\.international\\.coinbase\\.com)/\\S*orders?\\b",
    "(?:api[1-4]?\\.binance\\.(?:com|us)|fapi\\.binance\\.com|dapi\\.binance\\.com)/\\S*order\\b",
    "(?:localhost|127\\.0\\.0\\.1):7496\\b",
    "iserver/account/[^/\\s]+/orders?\\b"
  ]
