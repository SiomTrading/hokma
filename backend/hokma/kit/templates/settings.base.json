{
  "disableAllHooks": false,
  "permissions": {
    "allow": [
      "mcp__hokma__trash_move",
      "mcp__hokma__today_show",
      "mcp__hokma__watchlist_all",
      "mcp__hokma__economic_calendar",
      "mcp__hokma__market_news",
      "mcp__hokma__earnings_calendar",
      "mcp__hokma__market_quote",
      "mcp__hokma__options_chain",
      "mcp__hokma__broker_list",
      "mcp__hokma__order_preview",
      "mcp__hokma__order_status",
      "mcp__hokma__order_list",
      "mcp__hokma__order_log",
      "mcp__hokma__position_list",
      "mcp__hokma__schwab_quotes",
      "mcp__hokma__schwab_quote",
      "mcp__hokma__schwab_option_chain",
      "mcp__hokma__schwab_expirations",
      "mcp__hokma__schwab_price_history",
      "mcp__hokma__schwab_movers",
      "mcp__hokma__schwab_market_hours",
      "mcp__hokma__schwab_instruments",
      "mcp__hokma__schwab_instrument_by_cusip",
      "mcp__hokma__schwab_account_list",
      "mcp__hokma__schwab_accounts",
      "mcp__hokma__schwab_orders",
      "mcp__hokma__schwab_order",
      "mcp__hokma__schwab_transactions",
      "mcp__hokma__schwab_transaction",
      "mcp__hokma__schwab_user_preference",
      "mcp__hokma__volatility_history",
      "mcp__hokma__portfolio_greeks",
      "mcp__hokma__account_activity"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_COMMAND}}"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|mcp__hokma__strategy_brief_write|mcp__hokma__strategy_code_save|mcp__hokma__strategy_code_verdict",
        "hooks": [
          {
            "type": "command",
            "command": "{{CREATOR_GATE_COMMAND}}"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HARDBLOCK_COMMAND}}"
          }
        ]
      }
    ]
  }
}
