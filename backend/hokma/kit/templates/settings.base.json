{
  "disableAllHooks": false,
  "permissions": {
    "allow": ["mcp__hokma__trash_move"],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [],
      "denyWrite": [],
      "denyRead": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_COMMAND}}"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HARDBLOCK_COMMAND}}"
          }
        ]
      }
    ]
  }
}
