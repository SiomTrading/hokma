{
  "version": 1,
  "asset_classes": ["equity", "crypto", "forex", "future"],
  "default_priority": {
    "equity": ["schwab", "alpaca", "finnhub"],
    "bars": ["schwab", "alpaca", "finnhub"],
    "options": ["schwab", "alpaca"],
    "crypto": ["coinbase", "finnhub"],
    "forex": ["finnhub"],
    "future": ["siomtrading_futures"],
    "news": ["finnhub", "alpaca"]
  },
  "providers": {
    "coinbase": {
      "name": "Coinbase",
      "asset_classes": ["crypto"],
      "needs_key": false,
      "key_fields": [],
      "enabled_by_default": true,
      "data_state": "live",
      "delay_seconds": 0,
      "max_symbols": 100,
      "url": "wss://ws-feed.exchange.coinbase.com",
      "test_symbol": "BTC-USD"
    },
    "alpaca": {
      "name": "Alpaca IEX",
      "asset_classes": ["equity"],
      "needs_key": true,
      "key_fields": ["key_id", "secret"],
      "enabled_by_default": true,
      "data_state": "live",
      "delay_seconds": 0,
      "max_symbols": 30,
      "url": "wss://stream.data.alpaca.markets/v2/iex",
      "test_symbol": "SPY"
    },
    "finnhub": {
      "name": "Finnhub",
      "asset_classes": ["equity", "forex", "crypto"],
      "needs_key": true,
      "key_fields": ["key"],
      "enabled_by_default": true,
      "data_state": "live",
      "delay_seconds": 0,
      "max_symbols": 50,
      "url": "wss://ws.finnhub.io",
      "test_symbol": "BTC-USD"
    },
    "siomtrading_futures": {
      "name": "SiomTrading Futures",
      "asset_classes": ["future"],
      "needs_key": true,
      "key_fields": ["key"],
      "enabled_by_default": true,
      "data_state": "live",
      "delay_seconds": 0,
      "max_symbols": 20,
      "url": "wss://stream.siomtrading.com/v1/stream/futures",
      "test_symbol": "NQ=F"
    },
    "schwab": {
      "name": "Schwab",
      "asset_classes": ["equity"],
      "needs_key": true,
      "key_fields": ["client_id", "client_secret"],
      "auth": "oauth",
      "enabled_by_default": true,
      "data_state": "live",
      "delay_seconds": 0,
      "max_symbols": 100,
      "test_symbol": "SPY"
    }
  },
  "polling": {
    "name": "Yahoo Finance",
    "interval_seconds": 20,
    "delay_seconds": {"future": 600, "equity": 900, "forex": 0, "crypto": 0, "index": 900}
  }
}
